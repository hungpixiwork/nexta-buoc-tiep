# ==============================================================================
# NEXTA (BƯỚC TIẾP) — OPEN-SOURCE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# UNESCO Youth Hackathon 2026
#
# INSTRUCTIONS:
# Copy this file to .env:
#   cp .env.example .env
# Fill in your local development or staging keys.
# NEVER commit your real .env file or production secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloudflare Credentials (Workers, D1 SQL, R2, KV, Vectorize)
# ------------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_D1_DATABASE_ID=0c140f01-30b6-4763-936d-9ab1334e8269
CLOUDFLARE_KV_NAMESPACE_ID=d2a5863083824b99874ed8dcb02448f1

# ------------------------------------------------------------------------------
# 2. Application Auth & Cryptography Secrets
# ------------------------------------------------------------------------------
# 32+ byte random string for signing JWT bearer tokens
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
# 32+ byte master key for AES-256-GCM PII field-level encryption
PII_ENCRYPTION_KEY=your_pii_aes_256_gcm_master_key_here
# Shared secret header for triggering background SLA cron jobs
CRON_SECRET=your_cron_sla_verification_secret_here

# ------------------------------------------------------------------------------
# 3. AI & Speech Processing Keys (Assistive Infrastructure Only)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Web Speech / Note Structuring Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter Gateway (Optional alternative LLM router)
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# 4. Telegram Notification & Alert Bot (Field Emergencies & Survey Intake)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_or_channel_id_here

# ------------------------------------------------------------------------------
# 5. Cloudflare R2 Storage (S3-Compatible Object Storage for Audio/Evidence)
# ------------------------------------------------------------------------------
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=buoc-tiep-files

# ------------------------------------------------------------------------------
# 6. Google OAuth (Caseworker & Partner Authentication)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# 7. Frontend Client API Endpoints (Local or Live Edge Worker)
# ------------------------------------------------------------------------------
# For local dev: http://localhost:8787
# For live production: https://buoc-tiep-api.ppnh10092002.workers.dev
VITE_API_URL=http://localhost:8787
EXPO_PUBLIC_API_URL=http://localhost:8787

# ------------------------------------------------------------------------------
# 8. Optional Documentation & Knowledge Sync
# ------------------------------------------------------------------------------
NOTION_API_TOKEN=your_notion_integration_token_here
