{
  "name": "@buoc-tiep/zalo",
  "version": "1.0.0",
  "private": true,
  "description": "BƯỚC TIẾP — Zalo Mini App cho người đồng hành và điều phối viên",
  "type": "module",
  "browserslist": [
    "Android >= 5",
    "IOS >= 9.3",
    "Chrome >= 49",
    "Safari >= 9.1"
  ],
  "scripts": {
    "start": "npx -y zmp-cli@4 start",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "login": "npx -y zmp-cli@4 login",
    "deploy": "npx -y zmp-cli@4 deploy",
    "deploy:testing": "npx -y zmp-cli@4 deploy --testing",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@buoc-tiep/shared": "*",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^0.380.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "zmp-sdk": "^2.53.0",
    "zmp-ui": "^1.11.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.5",
    "vite": "^5.4.21",
    "zmp-vite-plugin": "^1.1.6"
  }
}
